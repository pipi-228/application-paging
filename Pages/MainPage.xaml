<Page x:Class="Lab7.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Главная" WindowTitle="Материальные ценности кафедры">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Margin="0,0,0,6">
            <MenuItem Header="Загрузить архив">
                <MenuItem Header="Из XML"      Click="LoadXml_Click"/>
                <MenuItem Header="Из Excel"    Click="LoadExcel_Click"/>
                <MenuItem Header="Из БД"       Click="LoadDb_Click"/>
                <MenuItem Header="Тестовые данные" Click="LoadSample_Click"/>
            </MenuItem>
            <MenuItem Header="О программе" Click="About_Click"/>
            <MenuItem Header="Выход"        Click="Exit_Click"/>
        </Menu>

        <!-- Заголовок -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Организация страниц приложения"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"
                       Text="Материальные ценности кафедры: наименование, инвентарный номер, № лаборатории, дата приобретения, стоимость, срок службы, количество.&#x0A;Задание 1: список предметов, подлежащих списанию в заданный год.&#x0A;Задание 2: список пяти самых долгосрочных предметов."/>
        </StackPanel>

        <!-- Навигация (гиперссылки) -->
        <Border Grid.Row="2" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320">
                <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,12"
                           HorizontalAlignment="Center">Навигация</TextBlock>

                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="ArchivePage.xaml">📋  Просмотр / редактирование архива</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="Task1Page.xaml">📌  Задание 1 — Предметы к списанию</Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,6">
                    <Hyperlink NavigateUri="Task2Page.xaml">🏆  Задание 2 — Пять самых долгосрочных</Hyperlink>
                </TextBlock>

                <Separator Margin="0,12"/>
                <TextBlock Name="statusText" Text="Архив не загружен." Foreground="Gray"
                           HorizontalAlignment="Center" FontStyle="Italic"/>
            </StackPanel>
        </Border>

        <!-- Подсказка -->
        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="Gray" FontSize="11"
                   Text="Загрузите архив через меню «Загрузить архив», затем перейдите на нужную страницу."/>
    </Grid>
</Page>
