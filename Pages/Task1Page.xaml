<Page x:Class="Lab7.Pages.Task1Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Задание 1" WindowTitle="Предметы к списанию"
      Initialized="Page_Initialized">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"
                   Text="Задание 1 — Предметы, подлежащие списанию"/>

        <!-- Параметр: год -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="Год списания:" VerticalAlignment="Center"/>
            <TextBox Name="tbYear" Width="80" Margin="4,0" VerticalContentAlignment="Center"
                     Text="{Binding Path=., UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Показать" Width="90" Click="Show_Click" Margin="4,0"/>
            <TextBlock Name="countLabel" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555"/>
        </StackPanel>

        <!-- Результат -->
        <DataGrid Grid.Row="2" Name="resultGrid"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False"
                  AlternatingRowBackground="#FFF5E6"
                  ColumnHeaderHeight="28" RowHeight="24">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование"    Binding="{Binding Name}"            Width="160"/>
                <DataGridTextColumn Header="Инв. №"          Binding="{Binding InventoryNumber}"  Width="70"/>
                <DataGridTextColumn Header="Лаб."            Binding="{Binding LabNumber}"        Width="50"/>
                <DataGridTextColumn Header="Дата покупки"    Binding="{Binding PurchaseDate}"     Width="95"/>
                <DataGridTextColumn Header="Стоимость" Binding="{Binding Cost,StringFormat=N2}" Width="110"/>
                <DataGridTextColumn Header="Срок, лет"       Binding="{Binding ServiceLife}"      Width="75"/>
                <DataGridTextColumn Header="Кол-во"          Binding="{Binding Quantity}"         Width="60"/>
                <DataGridTextColumn Header="Год списания"    Binding="{Binding WriteOffYear}"     Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Навигация -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Margin="0,0,20,0">
                <Hyperlink NavigateUri="MainPage.xaml">← На главную</Hyperlink>
            </TextBlock>
            <TextBlock>
                <Hyperlink NavigateUri="ArchivePage.xaml">📋 К архиву</Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</Page>
